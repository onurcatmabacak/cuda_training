# Binaries produced by run_all.sh (prebuilt legacy binaries are tracked under bin/legacy/)
/bin/*
!/bin/legacy/

# Compiler logs and optimisation reports
/build/*

# Per-run results (results/legacy/ is tracked)
/results/run_*/
/results/latest

# Stable single-file report written by run_all.sh
/RESULTS.md

# Python bytecode
__pycache__/
*.pyc
